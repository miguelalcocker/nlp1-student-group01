\ProvidesPackageRCS $Header: /cvsroot/latex-beamer/latex-beamer/themes/color/beamercolorthemeMIT.sty,v 1.4 2007/01/28 20:48:24 tantau Exp $

\definecolor{pennred}{cmyk}{0,1,0.65,0.34}
\definecolor{uryellow}{cmyk}{0,0.133,1,0}
\definecolor{urblue}{cmyk}{1,0.449,0,0.502}
\definecolor{mitred}{cmyk}{0.24,1,0.78,0.17}
\definecolor{mitgray1}{cmyk}{0.48, 0.39, 0.39, 0.04}
\definecolor{mitgray2}{cmyk}{0.24, 0.20, 0.20, 0.00}



\mode<presentation>

\setbeamercolor*{palette primary}{use=structure,fg=white,bg= mitgray1} % Slide title 
\setbeamercolor*{palette secondary}{use=structure,fg=white,bg= mitgray1} % Logo 
\setbeamercolor*{palette tertiary}{use=structure,fg=white,bg= mitred}
\setbeamercolor*{palette quaternary}{fg=white,bg= mitred} % Footnote

\setbeamercolor*{sidebar}{use=structure,bg= black}
  
\setbeamercolor*{palette sidebar primary}{use=structure,fg=structure.fg!10}
\setbeamercolor*{palette sidebar secondary}{fg=white}
\setbeamercolor*{palette sidebar tertiary}{use=structure,fg=structure.fg!50}
\setbeamercolor*{palette sidebar quaternary}{fg=white}

\setbeamercolor*{titlelike}{parent=palette primary}

\setbeamercolor*{separation line}{}
\setbeamercolor*{fine separation line}{}

\setbeamercolor{itemize item}{fg=mitred}
\setbeamercolor{itemize subitem}{fg=mitred}
\setbeamercolor{itemize subsubitem}{fg=mitred}
\setbeamercolor{enumerate item}{fg=mitred}
\setbeamercolor{enumerate subitem}{fg=mitred}
\setbeamercolor{enumerate subsubitem}{fg=mitred}
\setbeamercolor{description item}{fg=mitred}


\mode
<all>
